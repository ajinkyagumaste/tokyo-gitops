<?xml version="1.0" encoding="utf-8"?>
<!-- Set Data to an HTTPS URL (or supported file URL) for the company wallpaper.
     This is deliberately a template and is NOT deployed until populated
     and renamed to .xml. -->
<SyncML xmlns="SYNCML:SYNCML1.2">
  <SyncBody>
    <Replace>
      <CmdID>1</CmdID>
      <Item>
        <Target>
          <LocURI>./Vendor/MSFT/Personalization/DesktopImageUrl</LocURI>
        </Target>
        <Meta>
          <Format xmlns="syncml:metinf">chr</Format>
          <Type>text/plain</Type>
        </Meta>
        <Data></Data>
      </Item>
    </Replace>
    <Final />
  </SyncBody>
</SyncML>
